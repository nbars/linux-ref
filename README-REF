

# Update upstream to most recent LTS version
```sh
git switch linux-4.19.y-ref
git remote add kernel.org https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
git fetch kernel.org
git rebase kernel.org/linux-4.19.y
```

# Build the kernel
```sh
# Install deps
sudo apt install build-essential bison flex bc lz4 debhelper pahole

# Copy old config
cp /boot/config-<...> .config

# Set new values to default value
make olddefconfig

scripts/config --disable CONFIG_SYSTEM_TRUSTED_KEYS

# Custom kernel name suffix
scripts/config --set-str CONFIG_LOCALVERSION 'ref'

# Build the kernel (.deb files are stored in parent dir)
make bindeb-pkg
```
